{
  "name": "@fox-drop/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsc -p tsconfig.build.json && node scripts/write-openapi.mjs ../../packages/api-schema/openapi.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/database/migrate-command.js",
    "storage:setup": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/storage/storage-setup-command.js",
    "admin:create-owner": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/modules/identity/create-owner-command.js",
    "placeholder:phone": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/modules/identity/placeholder-phone-command.js",
    "otp:pair": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/modules/identity/otp-sender-pair-command.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@fastify/cookie": "11.1.5",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-fastify": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@node-rs/argon2": "2.2.2",
    "@sentry/nestjs": "11.12.0",
    "baileys": "7.0.0-rc14",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "iovalkey": "0.4.0",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.6.0",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.10",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/valkey": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "centrifuge": "5.8.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "globals": "17.14.0",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
