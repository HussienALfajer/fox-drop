{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "eslint.web.mjs",
    "tsconfig.base.json",
    ".node-version"
  ],
  "tasks": {
    "//#lint:root": {
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONTEXT",
        "TESTCONTAINERS_*"
      ]
    },
    "build": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
