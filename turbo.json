{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "//#lint:root": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONTEXT",
        "TESTCONTAINERS_*"
      ]
    },
    "build": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
