{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "eslint.web.mjs",
    "tsconfig.base.json",
    ".node-version"
  ],
  "tasks": {
    "//#lint:root": {
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONTEXT",
        "TESTCONTAINERS_*"
      ]
    },
    "build": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "test:e2e": {
      "dependsOn": ["build", "^transit"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@fox-drop/server#test": {
      "cache": false,
      "dependsOn": ["^transit"],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONTEXT",
        "TESTCONTAINERS_*"
      ]
    },
    "@fox-drop/server#build": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/compose.yaml",
        "$TURBO_ROOT$/infra/centrifugo/**",
        "$TURBO_ROOT$/infra/storage/**"
      ],
      "outputs": ["dist/**"]
    },
    "@fox-drop/infra#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/compose.yaml",
        "$TURBO_ROOT$/apps/admin/src/media.ts",
        "$TURBO_ROOT$/apps/customer/lib/src/media.dart",
        "$TURBO_ROOT$/apps/server/src/modules/files/files.service.ts"
      ],
      "outputs": [],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONTEXT",
        "TESTCONTAINERS_*"
      ]
    },
    "@fox-drop/design-tokens#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/architecture/09-design-system.md",
        "$TURBO_ROOT$/docs/brand/fonts-manifest.json",
        "$TURBO_ROOT$/docs/brand/logo/**",
        "$TURBO_ROOT$/docs/brand/app-icon/**",
        "$TURBO_ROOT$/packages/core_tokens/lib/src/icons.g.dart",
        "$TURBO_ROOT$/packages/core_tokens/lib/src/tokens.g.dart",
        "$TURBO_ROOT$/packages/core_ui/lib/src/**",
        "$TURBO_ROOT$/packages/ui-web/src/**",
        "$TURBO_ROOT$/packages/ui-web/scripts/bundle.ts",
        "$TURBO_ROOT$/.fonts/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONTEXT",
        "TESTCONTAINERS_*"
      ]
    },
    "@fox-drop/ui-web#test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/brand/logo/mark/mark-orange-on-ivory-drop.svg",
        "$TURBO_ROOT$/scripts/countries.mjs",
        "$TURBO_ROOT$/packages/core_l10n/lib/src/countries.g.dart",
        "$TURBO_ROOT$/.fonts/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "DOCKER_CERT_PATH",
        "DOCKER_CONTEXT",
        "TESTCONTAINERS_*"
      ]
    },
    "@fox-drop/ui-web#build": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.fonts/**"],
      "outputs": ["dist/**"]
    },
    "@fox-drop/ui-web#test:e2e": {
      "dependsOn": ["build", "^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/brand/logo/mark/mark-orange-on-ivory-drop.svg",
        "$TURBO_ROOT$/scripts/countries.mjs",
        "$TURBO_ROOT$/packages/core_l10n/lib/src/countries.g.dart",
        "$TURBO_ROOT$/.fonts/**"
      ],
      "outputs": []
    }
  }
}
