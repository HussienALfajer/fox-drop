# The staging environment's public settings (architecture §17.1). Its secrets
# live only on the server, in /srv/foxdrop-staging/shared/.env.
FOXDROP_ENV=staging

# sslip.io names until the domain is bought (owner decision 2026-11-05): they
# resolve to the server's address, and Let's Encrypt issues for them.
ADMIN_HOST=foxdrop-staging-admin.109-199-111-169.sslip.io
PORTAL_HOST=foxdrop-staging-portal.109-199-111-169.sslip.io
API_HOST=foxdrop-staging-api.109-199-111-169.sslip.io

# Loopback ports behind nginx; the server's other sites use 3000 to 3073.
API_PORT=3110
ADMIN_PORT=3111
PORTAL_PORT=3112
