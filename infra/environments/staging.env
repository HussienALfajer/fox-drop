# The staging environment's public settings (architecture §17.1). Its secrets
# live only on the server, in /srv/foxdrop-staging/shared/.env.
FOXDROP_ENV=staging

# sslip.io names until the domain is bought (owner decision 2026-11-05): they
# resolve to the server's address, and Let's Encrypt issues for them.
ADMIN_HOST=foxdrop-staging-admin.109-199-111-169.sslip.io
PORTAL_HOST=foxdrop-staging-portal.109-199-111-169.sslip.io
API_HOST=foxdrop-staging-api.109-199-111-169.sslip.io

# Loopback ports behind nginx; the server's other sites use 3000 to 3073.
API_PORT=3110
ADMIN_PORT=3111
PORTAL_PORT=3112
# Centrifugo's WebSocket, behind nginx's /connection/ (architecture §6.1).
CENTRIFUGO_PORT=3113

# The support WhatsApp number the sending numbers point to when someone writes
# to them (architecture §8.3.3 item 9), in E.164. Empty until the owner sets it.
SUPPORT_WHATSAPP_NUMBER=
# The support phone number the apps call (AP §9.13 contact info), such as from
# «لديّ رمز من العمليات», in E.164. Empty until the owner sets it: the apps
# hide the call button.
SUPPORT_PHONE_NUMBER=

# The Firebase project's number, which App Check tokens name (architecture
# §8.3.3 item 1); not a secret. Empty until the owner creates the project:
# while it is empty, turning otp.app_check_required on refuses every code.
FIREBASE_PROJECT_NUMBER=
# The Firebase project's ID, which the staging APKs start Firebase with (the
# deploy skill, «App Check»); not a secret. Empty until the owner creates it.
FIREBASE_PROJECT_ID=
