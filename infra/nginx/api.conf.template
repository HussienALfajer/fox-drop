# FOX DROP ${FOXDROP_ENV}: the API under /v1, installed as
# /etc/nginx/snippets/foxdrop-${FOXDROP_ENV}-api.conf by infra/server/provision.sh
# and included in every server block of the site, so the panel and the portal
# call /v1 on their own origin (architecture §17.2).

# Sign-in, setup and code requests: the tight per-address limit.
location ~ ^/v1/[a-z]+/auth/(sign-in|code|setup/) {
    limit_req zone=foxdrop_${FOXDROP_ENV}_signin burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:${API_PORT};
    include snippets/foxdrop-proxy.conf;
}

# Centrifugo's WebSocket (architecture §6.1). The connection stays open, so
# it is proxied with its upgrade and a long read timeout; Centrifugo pings
# every 25 seconds.
location = /connection/websocket {
    proxy_pass http://127.0.0.1:${CENTRIFUGO_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
}

# Centrifugo's subscription proxy reaches the API directly on the
# environment's network, never through nginx.
location ~ ^/v1/[a-z]+/realtime/subscribe$ {
    return 404;
}

# The images (architecture §5.8, CU §4.5): imgproxy, which serves only its
# preset widths of public-media, through the cache. Reads only. imgproxy's
# own Cache-Control (a year) reaches the apps; no add_header here, so the
# server's security headers stay.
location /media/ {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:${IMGPROXY_PORT};
    include snippets/foxdrop-proxy.conf;
    proxy_cache foxdrop_${FOXDROP_ENV}_media;
    proxy_cache_valid 200 30d;
    proxy_cache_valid 404 1m;
    proxy_cache_lock on;
    proxy_cache_use_stale error timeout updating;
}

location /v1/ {
    proxy_pass http://127.0.0.1:${API_PORT};
    include snippets/foxdrop-proxy.conf;
}
