# FOX DROP ${FOXDROP_ENV}: the API under /v1, installed as
# /etc/nginx/snippets/foxdrop-${FOXDROP_ENV}-api.conf by infra/server/provision.sh
# and included in every server block of the site, so the panel and the portal
# call /v1 on their own origin (architecture §17.2).

# Sign-in, setup, code requests and a Windows PC's registration (slice
# 2.44): the tight per-address limit.
location ~ ^/v1/[a-z]+/auth/(sign-in|code|setup/|windows-registration|portal/(sign-in|code)) {
    limit_req zone=foxdrop_${FOXDROP_ENV}_signin burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:${API_PORT};
    include snippets/foxdrop-proxy.conf;
}

# Centrifugo's WebSocket (architecture §6.1). The connection stays open, so
# it is proxied with its upgrade and a long read timeout; Centrifugo pings
# every 20 seconds (centrifugo/config.yaml).
location = /connection/websocket {
    proxy_pass http://127.0.0.1:${CENTRIFUGO_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
}

# Centrifugo's subscription proxy reaches the API directly on the
# environment's network, never through nginx.
location ~ ^/v1/[a-z]+/realtime/subscribe$ {
    return 404;
}

# The images (architecture §5.8, CU §4.5): imgproxy through the cache, for
# exactly one shape of URL, a preset width of a published file
# (/media/_/w320/plain/menu/items/<uuid>.jpg), so no other URL can make
# imgproxy work and the cache cannot be bypassed (its key is the path, the
# query string ignored). Reads only. imgproxy's own Cache-Control (a year)
# reaches the apps; no add_header here, so the server's security headers stay.
location ~ "^/media/_/w(160|320|640|1280)/plain/(restaurants/logos|restaurants/covers|menu/items|content/categories|marketing/banners)/[0-9a-f-]{36}\.(jpg|png|webp)$" {
    limit_except GET { deny all; }
    proxy_pass http://127.0.0.1:${IMGPROXY_PORT}$uri;
    include snippets/foxdrop-proxy.conf;
    proxy_cache foxdrop_${FOXDROP_ENV}_media;
    proxy_cache_key $uri;
    proxy_cache_valid 200 30d;
    proxy_cache_valid 404 1m;
    proxy_cache_lock on;
    proxy_cache_use_stale error timeout updating;
}

location /media/ {
    return 404;
}

# The map (architecture §7.2): public-maps through the storage's website
# endpoint, whose Host names the bucket (no other bucket is a website), for
# every product on our own domain. Reads only; the range requests PMTiles
# reads by pass through. The objects' own Cache-Control (a year for a build's
# files, 5 minutes for style.json) reaches the apps. Its own rate limit
# replaces the server's general one here (limits.conf.template).
location /maps/ {
    limit_except GET { deny all; }
    limit_req zone=foxdrop_${FOXDROP_ENV}_maps burst=200 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:${MAPS_PORT}/;
    proxy_http_version 1.1;
    proxy_set_header Host public-maps;
    proxy_set_header Connection "";
    proxy_set_header Cookie "";
    proxy_read_timeout 60s;
}

# The restaurant app's Windows installer and Velopack's update feed (slice
# 2.44, architecture §12.3), the files foxdrop-windows-publish puts there.
# Reads only; no add_header, so the server's security headers stay.
location /downloads/windows/ {
    limit_except GET { deny all; }
    alias /var/www/foxdrop-${FOXDROP_ENV}-downloads/windows/;
    types {
        application/json json;
        application/octet-stream exe nupkg zip;
    }
    default_type text/plain;
}

location /v1/ {
    proxy_pass http://127.0.0.1:${API_PORT};
    include snippets/foxdrop-proxy.conf;
}
