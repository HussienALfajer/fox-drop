# FOX DROP ${FOXDROP_ENV}: what every HTTPS server block of the site shares,
# installed as /etc/nginx/snippets/foxdrop-${FOXDROP_ENV}-server.conf by
# infra/server/provision.sh.

# One certificate for the three hosts.
ssl_certificate /etc/letsencrypt/live/foxdrop-${FOXDROP_ENV}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/foxdrop-${FOXDROP_ENV}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;

access_log /var/log/nginx/foxdrop-${FOXDROP_ENV}.access.log;
error_log /var/log/nginx/foxdrop-${FOXDROP_ENV}.error.log warn;

server_tokens off;
client_max_body_size 1m;
client_body_timeout 20s;
limit_conn perip 100;
limit_req zone=general burst=50 nodelay;

include snippets/foxdrop-headers.conf;
include snippets/foxdrop-${FOXDROP_ENV}-api.conf;

# Dotfiles and source maps are never served.
location ~ /\. { return 404; }
location ~ \.map$ { return 404; }
