# FOX DROP ${FOXDROP_ENV}: the panel, the portal and the API host, installed as
# /etc/nginx/sites-available/foxdrop-${FOXDROP_ENV} by infra/server/provision.sh.
# Edit infra/nginx/site.conf.template in the repository, never on the server.
#
# nginx is the only public gateway (architecture §15.5). Every host sends /v1
# to the API and /media to imgproxy (snippets/foxdrop-${FOXDROP_ENV}-api.conf);
# the panel's host sends /public-media/incoming/ and /private-docs/incoming/
# (PUT) and /private-docs/exports/, /tickets/ and /restaurants/ (GET) to the
# storage, the API's host /public-media/incoming/ and /private-docs/incoming/
# (PUT, the apps' uploads); the panel and the
# portal send everything else to the web container, which answers unknown
# paths with index.html. The limit zones `general` and `perip` are the
# server's own (conf.d/rate-limits.conf).

server {
    listen 80;
    listen [::]:80;
    server_name ${ADMIN_HOST} ${PORTAL_HOST} ${API_HOST};
    access_log /var/log/nginx/foxdrop-${FOXDROP_ENV}.access.log;
    error_log /var/log/nginx/foxdrop-${FOXDROP_ENV}.error.log warn;
    location ^~ /.well-known/acme-challenge/ { root /var/www/foxdrop-acme; }
    location / { return 301 https://$host$request_uri; }
}

# The admin panel.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${ADMIN_HOST};
    include snippets/foxdrop-${FOXDROP_ENV}-server.conf;

    # The panel's uploads (architecture §5.8): a PUT signed by the API for
    # this host, passed to the storage with the same Host and path, so the
    # signature holds and the browser needs no CORS. Nothing else reaches the
    # storage, and only incoming/, the uploads' folder. 8 MB is the server's
    # limit for an image; nginx buffers the body, so Garage always gets its
    # signed Content-Length. The session cookie stays here, and the signed
    # query stays out of the access log.
    location /public-media/incoming/ {
        limit_except PUT { deny all; }
        client_max_body_size 9m;
        access_log off;
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/foxdrop-proxy.conf;
        proxy_set_header Cookie "";
    }

    # The Excel exports (architecture §5.9): a GET signed by the API for this
    # host, valid 5 minutes, passed to the storage the same way. Only GET (and
    # HEAD), only exports/; the private bucket's other files never leave
    # through here.
    location /private-docs/exports/ {
        limit_except GET { deny all; }
        access_log off;
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/foxdrop-proxy.conf;
        proxy_set_header Cookie "";
    }

    # The customers' report photos (CU §12.2, §9.5; slice 2.24a): a GET signed
    # by the API for this host, valid 10 minutes, for the ticket page. Only
    # GET (and HEAD), only tickets/.
    location /private-docs/tickets/ {
        limit_except GET { deny all; }
        access_log off;
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/foxdrop-proxy.conf;
        proxy_set_header Cookie "";
    }
    # A restaurant's contract and licence scans (AP §9.6.3 step 5; slice
    # 2.30a): the panel's PUT signed by the API into the private bucket's
    # incoming/, as /public-media/incoming/ is, and the scans' GET signed for
    # this host, valid 10 minutes, under restaurants/ only.
    location /private-docs/incoming/ {
        limit_except PUT { deny all; }
        client_max_body_size 9m;
        access_log off;
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/foxdrop-proxy.conf;
        proxy_set_header Cookie "";
    }
    location /private-docs/restaurants/ {
        limit_except GET { deny all; }
        access_log off;
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/foxdrop-proxy.conf;
        proxy_set_header Cookie "";
    }

    location / {
        proxy_pass http://127.0.0.1:${ADMIN_PORT};
        include snippets/foxdrop-proxy.conf;
    }
}

# The owner portal.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${PORTAL_HOST};
    include snippets/foxdrop-${FOXDROP_ENV}-server.conf;

    location / {
        proxy_pass http://127.0.0.1:${PORTAL_PORT};
        include snippets/foxdrop-proxy.conf;
    }
}

# The API for the apps: /v1 only.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${API_HOST};
    include snippets/foxdrop-${FOXDROP_ENV}-server.conf;

    # The restaurant owners' item photos (RA §9.2; slice 2.32b): a PUT signed
    # by the API for this host into public-media's incoming/, as the panel's.
    # The file stays unpublished until a change request is approved.
    location /public-media/incoming/ {
        limit_except PUT { deny all; }
        client_max_body_size 9m;
        access_log off;
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/foxdrop-proxy.conf;
        proxy_set_header Cookie "";
    }

    # The apps' uploads (CU §12.2, §9.5; slice 2.24a): a PUT signed by the API
    # for this host into the private bucket's incoming/, passed to the
    # storage as the panel's are. Only PUT, only incoming/.
    location /private-docs/incoming/ {
        limit_except PUT { deny all; }
        client_max_body_size 9m;
        access_log off;
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/foxdrop-proxy.conf;
        proxy_set_header Cookie "";
    }

    location / { return 404; }
}
