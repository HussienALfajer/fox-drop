# imgproxy (architecture §5.8, CU §4.5), the same in development
# (compose.yaml) and on the server (infra/compose.yaml); each adds the
# storage's address and the reader key. It serves only the public-media
# bucket, only these four widths, as WebP, under /media:
#   /media/_/w320/plain/<key>
# The URLs are not signed (no key or salt): with presets only and one bucket,
# anyone can ask for nothing but a listed width of a stored image. The apps
# build the URL (apps/admin/src/media.ts, apps/customer/lib/src/media.dart);
# infra.test.mjs keeps their widths equal to these.
IMGPROXY_PATH_PREFIX=/media
IMGPROXY_USE_S3=true
IMGPROXY_S3_REGION=garage
IMGPROXY_BASE_URL=s3://public-media/
IMGPROXY_ALLOWED_SOURCES=s3://public-media/
IMGPROXY_ONLY_PRESETS=true
IMGPROXY_PRESETS=w160=resizing_type:fit/width:160/format:webp,w320=resizing_type:fit/width:320/format:webp,w640=resizing_type:fit/width:640/format:webp,w1280=resizing_type:fit/width:1280/format:webp
# A key names one upload and is never reused, so a result never changes.
IMGPROXY_TTL=31536000
