# Local development only. Copy to .env; every value here is fake.
# Read by compose.yaml and by the server scripts run from apps/server.

# PostgreSQL superuser, used only by the container to create the roles below.
POSTGRES_PASSWORD=dev-postgres-password
# Runs the migrations and owns the schemas (apps/server/db/bootstrap.sql).
FOX_DROP_MIGRATOR_PASSWORD=dev-migrator-password
# The server connects with this role; it cannot change the schema.
FOX_DROP_APP_PASSWORD=dev-app-password

MIGRATION_DATABASE_URL=postgres://fox_drop_migrator:dev-migrator-password@127.0.0.1:5432/fox_drop
DATABASE_URL=postgres://fox_drop_app:dev-app-password@127.0.0.1:5432/fox_drop

VALKEY_PASSWORD=dev-valkey-password
# The server connects with this URL; the password matches VALKEY_PASSWORD.
VALKEY_URL=redis://:dev-valkey-password@127.0.0.1:6379

CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_API_KEY=dev-centrifugo-api-key

# Host ports, when the defaults are taken on this machine. Change the URLs
# above to match a new POSTGRES_PORT or VALKEY_PORT.
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
# CENTRIFUGO_PORT=8000
