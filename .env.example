# Local development only. Copy to .env; every value here is fake.
# Read by compose.yaml and by the server scripts run from apps/server.

# PostgreSQL superuser, used only by the container to create the roles below.
POSTGRES_PASSWORD=dev-postgres-password
# Runs the migrations and owns the schemas (apps/server/db/bootstrap.sql).
FOX_DROP_MIGRATOR_PASSWORD=dev-migrator-password
# The server connects with this role; it cannot change the schema.
FOX_DROP_APP_PASSWORD=dev-app-password

MIGRATION_DATABASE_URL=postgres://fox_drop_migrator:dev-migrator-password@127.0.0.1:5432/fox_drop
DATABASE_URL=postgres://fox_drop_app:dev-app-password@127.0.0.1:5432/fox_drop

VALKEY_PASSWORD=dev-valkey-password
# The server connects with this URL; the password matches VALKEY_PASSWORD.
VALKEY_URL=redis://:dev-valkey-password@127.0.0.1:6379

# Where the server runs: development here, staging or production when
# deployed. Only development prints app sign-in codes instead of sending them.
FOX_DROP_ENVIRONMENT=development

# Encrypts phone numbers and TOTP secrets (architecture §15.3): 32 bytes in
# base64, such as the output of `openssl rand -base64 32`.
IDENTITY_ENCRYPTION_KEY=ZGV2LWlkZW50aXR5LWVuY3J5cHRpb24ta2V5LTMyYnk=
# The otp-sender's reply to someone who writes to a sending number points to
# this support WhatsApp number (architecture §8.3.3 item 9). Fake here.
SUPPORT_WHATSAPP_NUMBER=+963900000000
# The support phone number the apps call, such as from «لديّ رمز من العمليات»
# (AP §9.13 contact info, until Content's screen). Fake here.
SUPPORT_PHONE_NUMBER=+963900000009
# The Firebase project's number, which App Check tokens name (architecture
# §8.3.3 item 1). Fake here: App Check stays off (otp.app_check_required).
FIREBASE_PROJECT_NUMBER=000000000000
# Push (architecture §8.1): a Firebase service account's JSON key in base64.
# Empty here: push is off, and the worker queues the pushes without sending.
FCM_SERVICE_ACCOUNT=
# The admin panel, for the setup links the server prints (AP §5.3).
ADMIN_PANEL_URL=http://localhost:5173

# Real time (architecture §6): the API signs connection tokens with the token
# secret, the worker publishes through the HTTP API, and Centrifugo's
# subscription proxy sends the proxy secret. Real time is off while one is
# missing.
CENTRIFUGO_API_URL=http://127.0.0.1:8000/api
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_PROXY_SECRET=dev-centrifugo-proxy-secret

# OSRM, one server per vehicle profile (architecture §7.1), started with
# `docker compose --profile osrm up --detach` after its data is built (see
# compose.yaml). While it is down, distances are the straight line × 1.3.
OSRM_CAR_URL=http://127.0.0.1:5001
OSRM_MOTORBIKE_URL=http://127.0.0.1:5002
OSRM_BICYCLE_URL=http://127.0.0.1:5003
OSRM_WALKING_URL=http://127.0.0.1:5004

# Host ports, when the defaults are taken on this machine. Change the URLs
# above to match a new POSTGRES_PORT, VALKEY_PORT or CENTRIFUGO_PORT.
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
# CENTRIFUGO_PORT=8000
