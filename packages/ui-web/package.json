{
  "name": "@fox-drop/ui-web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build -o dist/storybook",
    "design-system": "node scripts/design-system.ts",
    "components-canvas": "node scripts/components-canvas/canvas.ts",
    "components-canvas:check": "node scripts/components-canvas/check.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=functional",
    "test:visual": "node scripts/visual-docker.mjs"
  },
  "dependencies": {
    "@fox-drop/design-tokens": "workspace:*",
    "@ui-sdk/core": "0.1.0-beta.14",
    "@ui-sdk/react": "0.1.0-beta.14",
    "libphonenumber-js": "1.13.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-variants": "4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.32",
    "react-18": "npm:react@18.3.1",
    "react-dom-18": "npm:react-dom@18.3.1",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
