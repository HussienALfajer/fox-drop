  "info": {
    "title": "FOX DROP API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "StatusDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "serverTime": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The server clock in Unix milliseconds."
          }
        },
        "required": [
          "status",
          "serverTime"
        ],
        "additionalProperties": false
      },
      "SetupTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "token"
        ]
      },
      "TotpEnrolmentDto_Output": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "The TOTP secret in base32, for typing it in by hand."
          },
          "otpauthUri": {
            "type": "string",
            "description": "The otpauth:// URI the panel shows as a QR code."
          }
        },
        "required": [
          "secret",
          "otpauthUri"
        ],
        "additionalProperties": false
      },
      "CompleteSetupDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "A TOTP code from the secret just enrolled."
          }
        },
        "required": [
          "token",
          "password",
          "code"
        ]
      },
      "BackupCodesDto_Output": {
        "type": "object",
        "properties": {
          "backupCodes": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "string"
            },
            "description": "The 10 single-use backup codes, shown this once only (AP §5.1)."
          }
        },
        "required": [
          "backupCodes"
        ],
        "additionalProperties": false
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254,
            "description": "The email, or the phone in international form."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "A 6-digit TOTP code or a backup code."
          }
        },
        "required": [
          "login",
          "password",
          "code"
        ]
      },
      "AdminSessionDto_Output": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The union of the roles' permissions (AP §6.1), so the panel hides what is not allowed."
          },
          "signedInAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "When the session ends unless used again before (AP §5.2)."
          }
        },
        "required": [
          "accountId",
          "roles",
          "permissions",
          "signedInAt",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "SignedOutDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "signed_out"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "TeamUsersDto_Output": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "phone": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "active",
                    "totp_reset",
                    "disabled"
                  ]
                },
                "totpEnrolled": {
                  "type": "boolean"
                },
                "lastSignInAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "openSessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "userAgent": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ipAddress": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "signedInAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      "lastActivityAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      }
                    },
                    "required": [
                      "id",
                      "userAgent",
                      "ipAddress",
                      "signedInAt",
                      "lastActivityAt"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "email",
                "phone",
                "roles",
                "status",
                "totpEnrolled",
                "lastSignInAt",
                "openSessions"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "users"
        ],
        "additionalProperties": false
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ]
          },
          "phone": {
            "description": "In international form, such as +963944000000.",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ]
          },
          "roles": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "OWN",
                "OPS",
                "SUP",
                "FIN",
                "DATA"
              ]
            },
            "description": "One or more roles (AP §6.1)."
          }
        },
        "required": [
          "name",
          "roles"
        ]
      },
      "SetupLinkDto_Output": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "setupToken": {
            "type": "string",
            "description": "Shown this once. The panel puts it in its setup link, after /setup#token=, for the owner to share."
          },
          "setupExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "accountId",
          "setupToken",
          "setupExpiresAt"
        ],
        "additionalProperties": false
      },
      "ChangeRolesDto": {
        "type": "object",
        "properties": {
          "roles": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "OWN",
                "OPS",
                "SUP",
                "FIN",
                "DATA"
              ]
            },
            "description": "One or more roles (AP §6.1)."
          }
        },
        "required": [
          "roles"
        ]
      },
      "DoneDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "done"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "RoleMatrixDto_Output": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "role",
                "permissions"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "headers": {
      "Server-Time": {
        "description": "The server clock in Unix milliseconds. The apps compute their clock offset from it (RA §4.7).",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\d+$"
        }
      }
    }
  }
}
