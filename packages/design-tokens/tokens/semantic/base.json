    },
    "sm": {
      "$value": "{primitive.space.12}",
      "$description": "Between related items in a list or a form."
    },
    "md": {
      "$value": "{primitive.space.16}",
      "$description": "Card padding and the screen margin."
    },
    "lg": {
      "$value": "{primitive.space.24}",
