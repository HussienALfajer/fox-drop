{
  "space": {
    "$type": "dimension",
    "$description": "Semantic steps of the 4-point grid.",
    "none": {
      "$value": "{primitive.space.0}",
      "$description": "No gap."
    },
    "2xs": {
      "$value": "{primitive.space.4}",
      "$description": "Between an icon and its label."
    },
    "xs": {
      "$value": "{primitive.space.8}",
      "$description": "Inside chips and between tight rows."
    },
    "sm": {
      "$value": "{primitive.space.12}",
      "$description": "Between related items in a list or a form."
    },
    "md": {
      "$value": "{primitive.space.16}",
      "$description": "Card padding and the screen margin."
    },
    "lg": {
      "$value": "{primitive.space.24}",
      "$description": "Between groups on a screen."
    },
    "xl": {
      "$value": "{primitive.space.32}",
      "$description": "Between sections."
    },
    "2xl": {
      "$value": "{primitive.space.48}",
      "$description": "Around empty states and above a page title on the web."
    },
    "3xl": {
      "$value": "{primitive.space.64}",
      "$description": "The largest gap, for wide web layouts."
    }
  },
  "radius": {
    "$type": "dimension",
