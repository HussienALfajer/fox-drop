      "$value": "{primitive.radius.4}",
      "$description": "Deprecated: use radius.sm.",
      "$deprecated": "radius.sm: the Figma file has no 4 px corner"
    },
    "sm": {
      "$value": "{primitive.radius.8}",
      "$description": "Small cards and image slots."
    },
    "md": {
      "$value": "{primitive.radius.10}",
      "$description": "Inputs, badges, product cards."
    },
    "lg": {
      "$value": "{primitive.radius.15}",
      "$description": "Cart items, totals, bars."
    },
    "xl": {
      "$value": "{primitive.radius.30}",
      "$description": "Banners and sheets."
    },
    "full": {
      "$value": "{primitive.radius.full}",
      "$description": "Pills and circles: buttons, search, tags, icon buttons."
    }
  },
  "elevation": {
    "$type": "shadow",
