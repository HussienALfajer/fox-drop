      "$value": "{primitive.duration.1200}",
      "$description": "A signature moment, never more."
    }
  },
  "layer": {
    "$type": "number",
    "$description": "The stacking order of overlays (D.10): a CSS z-index; Flutter stacks by Overlay order.",
    "sticky": {
      "$value": 10,
      "$description": "Top bar, bottom navigation, rail, a sticky table header."
    },
    "banner": { "$value": 20, "$description": "Banners under the top bar." },
    "overlay": { "$value": 30, "$description": "Scrim, dialog, bottom sheet, side drawer." },
    "menu": { "$value": 40, "$description": "Menu and select list, also inside a dialog." },
    "toast": { "$value": 50, "$description": "Toasts, above an open sheet." },
    "tooltip": { "$value": 60, "$description": "Tooltips." },
    "blocking": {
      "$value": 70,
      "$description": "The blocking sound banner (AP §7.3), above everything."
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": "{primitive.easing.calm}"
    }
  },
  "motion": {
    "$description": "Motions as numbers, not curves (brand expression §3): two loops (slice D.11b), each on its own duration with a still frame for reduced motion, and the entrances' slides (slice D.W1).",
    "enter": {
      "$description": "Where a Flutter panel slides in from, as a share of its own height below its place.",
      "sheet": {
        "$type": "number",
        "$value": 1,
        "$description": "The bottom sheet: from fully below."
      },
      "toast": {
        "$type": "number",
        "$value": 0.15,
        "$description": "The phone toast (the web toaster rises space.xs: a parity gap for D.W3c)."
      }
    },
    "pulse": {
      "$description": "The live dot's soft ring: it grows and fades, then starts again.",
      "duration": { "$type": "duration", "$value": "{duration.moment}" },
      "scale-from": { "$type": "number", "$value": 1 },
      "scale-to": { "$type": "number", "$value": 1.7 },
      "opacity-from": { "$type": "number", "$value": 0.7 },
      "opacity-to": { "$type": "number", "$value": 0 },
      "still-scale": {
        "$type": "number",
        "$value": 1.25,
        "$description": "The ring under reduced motion."
      },
      "still-opacity": {
        "$type": "number",
        "$value": 0.35,
        "$description": "The ring under reduced motion."
      }
    },
    "mark-fill": {
      "$description": "The loader: a liquid rises through the faint mark, then the mark fades back; one cycle, no pause.",
      "duration": { "$type": "duration", "$value": "{duration.moment}" },
      "rise": {
        "$type": "number",
        "$value": 0.7,
        "$description": "The share of the cycle the liquid takes to fill the mark."
      },
      "fade": {
        "$type": "number",
        "$value": 0.18,
        "$description": "The share of the cycle, at its end, the full mark takes to fade back."
      },
      "wave-period": {
        "$type": "duration",
        "$value": "700ms",
        "$description": "One sway of the liquid's surface."
      },
      "faint-opacity": {
        "$type": "number",
        "$value": 0.35,
        "$description": "The empty mark under the liquid."
      },
      "still-level": {
        "$type": "number",
        "$value": 0.5,
        "$description": "The level shown under reduced motion: half full."
      }
    }
  },
