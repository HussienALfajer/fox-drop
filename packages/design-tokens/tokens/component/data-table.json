{
  "data-table": {
    "$description": "The panel's and the portal's table: web only, so every token says so.",
    "$extensions": {
      "app.foxdrop": { "web": ["data-table"], "flutter": [] }
    },
    "row-height": {
      "$type": "dimension",
      "$value": "{size.control-compact}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.thin}",
      "$description": "The table's outline and the rule above each row.",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "sort-gap": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "inner-radius": {
      "$type": "dimension",
      "$value": "{radius.xs}",
      "$description": "The sort button's focus corner and a loading line's.",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "loading-line-height": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "border": {
        "$value": "{color.border}",
        "$description": "The table's outline and the rule above each row.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "head-background": {
        "$value": "{color.surface}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "head-text": {
        "$value": "{color.on-surface-muted}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "text": {
        "$value": "{color.on-surface}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "row-hover": {
        "$value": "{color.surface-raised-hover}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "row-selected": {
        "$value": "{color.primary-subtle}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "loading": {
        "$value": "{color.neutral-subtle}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    }
  }
}
