{
  "card": {
    "$extensions": {
      "app.foxdrop": { "web": ["card"], "flutter": ["card"] }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "Between the web card's children; a Flutter card holds one child, which lays out its own.",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.thin}"
    },
    "color": {
      "$type": "color",
      "background": { "$value": "{color.surface-raised}" },
      "background-hover": { "$value": "{color.surface-raised-hover}" },
      "background-pressed": { "$value": "{color.surface-raised-pressed}" },
      "border": { "$value": "{color.border}" },
      "text": {
        "$value": "{color.on-surface}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    },
    "danger": {
      "border-width": {
        "$type": "dimension",
        "$value": "{border-width.thick}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.danger-subtle}",
        "$description": "A late order (RA §8.2); it keeps the tint under the pointer."
      },
      "border": {
        "$type": "color",
        "$value": "{color.danger}"
      }
    }
  }
}
