{
  "drop-loader": {
    "$extensions": {
      "app.foxdrop": { "web": ["drop-loader"], "flutter": ["drop_loader"] }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": "{size.icon-sm}",
        "$description": "Inside a field; the drop alone."
      },
      "md": {
        "$value": "{size.icon-md}",
        "$description": "Inside a button."
      },
      "lg": {
        "$value": "{size.touch-target}",
        "$description": "A part of a page."
      }
    },
    "color": {
      "$type": "color",
      "$description": "On a light ground an ivory drop under orange pieces, so the fox shows ivory; on orange the other way round. The small loader's drop takes the pieces' colour.",
      "drop": { "$value": "{color.on-primary}" },
      "pieces": { "$value": "{color.brand}" },
      "on-primary-drop": { "$value": "{color.primary}" },
      "on-primary-pieces": { "$value": "{color.on-primary}" }
    }
  }
}
