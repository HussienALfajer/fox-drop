{
  "bottom-sheet": {
    "$extensions": {
      "app.foxdrop": { "web": ["bottom-sheet"], "flutter": ["bottom_sheet"] }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.xl}",
      "$description": "The plain top's corners; the S-curve top draws its own."
    },
    "max-width": {
      "$type": "dimension",
      "$value": "{size.dialog}",
      "$description": "On a wide web page the sheet is centred at this width; on a phone it spans the screen, as in Flutter.",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.lg}"
    },
    "padding-top": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "Above the plain top's handle."
    },
    "padding-bottom": {
      "$type": "dimension",
      "$value": "{space.md}",
      "$description": "Under the content, above the home indicator."
    },
    "handle": {
      "width": { "$type": "dimension", "$value": "{size.sheet-handle}" },
      "height": { "$type": "dimension", "$value": "{border-width.heavy}" }
    },
    "curve": {
      "width": {
        "$type": "dimension",
        "$value": "{space.2xl}",
        "$description": "The S-curve between the tab and the lower edge (brand expression §2)."
      },
      "height": {
        "$type": "dimension",
        "$value": "{space.lg}",
        "$description": "How much lower the edge beside the tab sits: the band of the handle."
      },
      "tab-share": {
        "$type": "number",
        "$value": 0.6,
        "$description": "The tab's share of the width; the web writes it as `basis-2/5` for the lower edge.",
        "$extensions": { "app.foxdrop": { "sides": ["flutter"] } }
      }
    },
    "color": {
      "$type": "color",
      "background": { "$value": "{color.surface-raised}" },
      "background-s-curve": {
        "$value": "{color.surface}",
        "$description": "The customer's item sheet, under its S-curve tab."
      },
      "handle": { "$value": "{color.border-strong}" },
      "title": { "$value": "{color.on-surface}" },
      "title-s-curve": { "$value": "{color.heading}" }
    }
  }
}
