{
  "dialog": {
    "$description": "The dialog and the confirm dialog (D.10): the raised panel over the scrim. The web drawer shares the scrim through overlay/styles.ts.",
    "$extensions": {
      "app.foxdrop": {
        "web": ["dialog", "confirm-dialog", "overlay"],
        "flutter": ["dialog"]
      }
    },
    "width": {
      "$type": "dimension",
      "$value": "{size.dialog}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.lg}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.md}",
      "$description": "Between the header, each section and the actions."
    },
    "header-gap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "The title to its ×."
    },
    "actions-gap": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}"
      },
      "scrim": {
        "$value": "{color.scrim}"
      },
      "title": {
        "$value": "{color.on-surface}"
      },
      "body": {
        "$value": "{color.on-surface-muted}"
      }
    },
    "confirm": {
      "section-gap": {
        "$type": "dimension",
        "$value": "{space.xs}",
        "$description": "A section's title to its content (the money effect, who is notified)."
      },
      "effect-padding": {
        "$type": "dimension",
        "$value": "{space.sm}"
      },
      "effect-radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "chip-height": {
        "$type": "dimension",
        "$value": "{space.lg}"
      },
      "chip-padding-inline": {
        "$type": "dimension",
        "$value": "{space.xs}"
      },
      "chip-gap": {
        "$type": "dimension",
        "$value": "{space.2xs}"
      },
      "color": {
        "$type": "color",
        "effect-background": {
          "$value": "{color.surface}"
        },
        "chip-background": {
          "$value": "{color.info-subtle}"
        },
        "chip-text": {
          "$value": "{color.info}"
        }
      }
    }
  }
}
