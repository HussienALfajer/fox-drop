{
  "money": {
    "$extensions": {
      "app.foxdrop": { "web": ["money"], "flutter": ["money"] }
    },
    "color": {
      "$type": "color",
      "default": { "$value": "{color.on-surface}" },
      "success": {
        "$value": "{color.success}",
        "$description": "A discount or a gain."
      },
      "danger": {
        "$value": "{color.danger}",
        "$description": "An amount owed."
      },
      "muted": {
        "$value": "{color.on-surface-muted}",
        "$description": "The web's muted tone; a Flutter caller passes its own colour.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "inverse": {
        "$value": "{color.on-primary}",
        "$description": "On the orange total bar; the Flutter summary reads amounts-summary.prominent.label.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    }
  }
}
