{
  "toast": {
    "$description": "A toast (D.10, option A): dark blue with ivory words, the tone carried by its icon.",
    "$extensions": {
      "app.foxdrop": { "web": ["toaster"], "flutter": ["toast"] }
    },
    "width": {
      "$type": "dimension",
      "$value": "{size.toast}",
      "$description": "The widest a toast grows; narrower screens keep md on each side."
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "Between the icon, the words, the action and the ×."
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.accent}"
      },
      "text": {
        "$value": "{color.on-accent}"
      },
      "icon-success": {
        "$value": "{color.success-subtle}"
      },
      "icon-info": {
        "$value": "{color.info-subtle}"
      },
      "icon-warning": {
        "$value": "{color.warning-subtle}"
      },
      "icon-danger": {
        "$value": "{color.danger-subtle}"
      }
    }
  }
}
