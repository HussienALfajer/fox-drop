{
  "input": {
    "$extensions": {
      "app.foxdrop": {
        "web": [
          "field",
          "text-field",
          "text-area",
          "search-field",
          "phone-field",
          "code-field",
          "select",
          "checkbox",
          "radio-group",
          "switch",
          "quantity-stepper"
        ],
        "flutter": [
          "field",
          "text_field",
          "phone_field",
          "code_field",
          "select",
          "checkbox",
          "radio",
          "switch",
          "quantity_stepper",
          "internal"
        ]
      }
    },
    "height": {
      "$type": "dimension",
      "$value": "{size.control}"
    },
    "compact": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control-compact}",
        "$description": "The panel's and the portal's compact density; the Flutter fields have none.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{space.sm}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    },
    "message-gap": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$description": "Between the error's icon and its text, below the control."
    },
    "area-padding-block": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "Above and below the text of a long-text box."
    },
    "clear": {
      "size": {
        "$type": "dimension",
        "$value": "{size.step}",
        "$description": "The clear button's circle (the D.8 sheet's 32)."
      },
      "target": {
        "$type": "dimension",
        "$value": "{size.touch-target}"
      },
      "color": {
        "$type": "color",
        "background": {
          "$value": "{color.surface}"
        },
        "background-hover": {
          "$value": "{color.surface-hover}"
        },
        "background-pressed": {
          "$value": "{color.surface-pressed}"
        },
        "icon": {
          "$value": "{color.on-surface}"
        }
      }
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "label-gap": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "area-radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.thin}"
    },
    "focus-width": {
      "$type": "dimension",
      "$value": "{border-width.thick}"
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}"
      },
      "border": {
        "$value": "{color.border-strong}"
      },
      "border-hover": {
        "$value": "{color.border-hover}"
      },
      "border-focus": {
        "$value": "{color.primary}"
      },
      "border-invalid": {
        "$value": "{color.danger}"
      },
      "text": {
        "$value": "{color.on-surface}"
      },
      "placeholder": {
        "$value": "{color.on-surface-muted}"
      },
      "label": {
        "$value": "{color.on-surface}"
      },
      "hint": {
        "$value": "{color.on-surface-muted}"
      },
      "error": {
        "$value": "{color.danger}"
      },
      "accent": {
        "$value": "{color.primary}"
      },
      "focus-ring": {
        "$value": "{color.focus-ring}",
        "$description": "The keyboard ring of a control without an outline. Flutter paints it in the shared FocusRing (internal/interaction.dart, every component's ring), read as theme.input.focusRing.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "disabled": {
        "$value": "{color.disabled}"
      },
      "on-disabled": {
        "$value": "{color.on-disabled}"
      }
    },
    "check": {
      "size": {
        "$type": "dimension",
        "$value": "{size.selection}"
      },
      "target": {
        "$type": "dimension",
        "$value": "{size.touch-target}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.2xs}",
        "$description": "Between the 48 target and the label (the D.8 sheet)."
      },
      "dot": {
        "$type": "dimension",
        "$value": "{space.sm}",
        "$description": "The selected radio's dot."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "{border-width.thick}"
      },
      "color": {
        "$type": "color",
        "background": {
          "$value": "{color.surface-raised}"
        },
        "background-hover": {
          "$value": "{color.surface-raised-hover}"
        },
        "background-pressed": {
          "$value": "{color.surface-raised-pressed}"
        },
        "border": {
          "$value": "{color.border-strong}"
        },
        "border-hover": {
          "$value": "{color.border-hover}"
        },
        "checked": {
          "$value": "{color.primary}"
        },
        "checked-hover": {
          "$value": "{color.primary-hover}"
        },
        "checked-pressed": {
          "$value": "{color.primary-pressed}"
        },
        "mark": {
          "$value": "{color.on-primary}"
        }
      }
    },
    "switch": {
      "width": {
        "$type": "dimension",
        "$value": "{size.switch-width}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{size.switch-height}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.2xs}",
        "$description": "Around the thumb, inside the track."
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.sm}",
        "$description": "Between the track and its visible label; the Flutter switch shows no label (the screen's line does).",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "color": {
        "$type": "color",
        "track": {
          "$value": "{color.border-strong}"
        },
        "track-hover": {
          "$value": "{color.border-hover}"
        },
        "track-pressed": {
          "$value": "{color.border-pressed}"
        },
        "track-on": {
          "$value": "{color.primary}"
        },
        "track-on-hover": {
          "$value": "{color.primary-hover}"
        },
        "track-on-pressed": {
          "$value": "{color.primary-pressed}"
        },
        "thumb": {
          "$value": "{color.surface-raised}"
        }
      }
    },
    "stepper": {
      "size": {
        "$type": "dimension",
        "$value": "{size.step}"
      },
      "value-width": {
        "$type": "dimension",
        "$value": "{space.2xl}",
        "$description": "The count's cell between the two buttons."
      },
      "target": {
        "$type": "dimension",
        "$value": "{size.touch-target}"
      },
      "color": {
        "$type": "color",
        "background": {
          "$value": "{color.surface-raised}"
        },
        "background-hover": {
          "$value": "{color.surface-raised-hover}"
        },
        "background-pressed": {
          "$value": "{color.surface-raised-pressed}"
        },
        "border": {
          "$value": "{color.primary}"
        },
        "value": {
          "$value": "{color.on-surface}"
        }
      }
    },
    "code": {
      "size": {
        "$type": "dimension",
        "$value": "{size.touch-target}"
      },
      "caret-height": {
        "$type": "dimension",
        "$value": "{size.icon-md}",
        "$description": "The caret in the empty cell the next digit goes into."
      },
      "color": {
        "$type": "color",
        "done": {
          "$value": "{color.primary}"
        },
        "on-done": {
          "$value": "{color.on-primary}"
        }
      }
    }
  }
}
