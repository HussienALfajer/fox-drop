{
  "tooltip": {
    "$description": "The web tooltip (D.10): navy with ivory words. Web only, so every token says so.",
    "$extensions": {
      "app.foxdrop": { "web": ["tooltip"], "flutter": [] }
    },
    "max-width": {
      "$type": "dimension",
      "$value": "{size.tooltip}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.sm}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.xs}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.on-surface}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "text": {
        "$value": "{color.on-accent}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    }
  }
}
