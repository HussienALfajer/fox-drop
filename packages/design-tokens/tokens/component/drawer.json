{
  "drawer": {
    "$description": "The web side drawer (D.10): full height, raised, a header with the title and the ×. Web only, so every token says so.",
    "$extensions": {
      "app.foxdrop": { "web": ["drawer"], "flutter": [] }
    },
    "width": {
      "$type": "dimension",
      "$value": "{size.drawer}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "header-height": {
      "$type": "dimension",
      "$value": "{size.bar}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "header-padding-inline": {
      "$type": "dimension",
      "$value": "{space.md}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "header-gap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.thin}",
      "$extensions": { "app.foxdrop": { "sides": ["web"] } }
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      },
      "border": {
        "$value": "{color.border}",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    }
  }
}
