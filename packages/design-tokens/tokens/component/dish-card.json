{
  "dish-card": {
    "$extensions": {
      "app.foxdrop": { "web": ["dish-card"], "flutter": ["dish_card"] }
    },
    "photo-size": {
      "$type": "dimension",
      "$value": "{size.dish-photo}",
      "$description": "The square photo; a dish without one has no image slot."
    },
    "photo-radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "Between the text and the photo."
    },
    "add-gap": {
      "$type": "dimension",
      "$value": "{space.xs}",
      "$description": "Before «+»."
    },
    "add-size": {
      "$type": "dimension",
      "$value": "{size.control-compact}",
      "$description": "The «+» circle, centred in its touch target."
    },
    "price-gap": {
      "$type": "dimension",
      "$value": "{space.xs}",
      "$description": "Above the price line, and between «من», the price and the reason."
    },
    "faded-opacity": {
      "$type": "number",
      "$value": 0.55,
      "$description": "What an unavailable dish fades (U7); its reason keeps its full contrast."
    },
    "color": {
      "$type": "color",
      "name": { "$value": "{color.heading}" },
      "add": { "$value": "{color.primary}" },
      "add-hover": { "$value": "{color.primary-hover}" },
      "add-pressed": { "$value": "{color.primary-pressed}" },
      "on-add": { "$value": "{color.on-primary}" },
      "count": {
        "$value": "{color.accent}",
        "$description": "«+» once the dish is in the cart, holding the count."
      },
      "on-count": { "$value": "{color.on-accent}" }
    }
  }
}
