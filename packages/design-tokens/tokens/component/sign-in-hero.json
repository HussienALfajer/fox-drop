{
  "sign-in-hero": {
    "$description": "The sign-in screen's head (D.11 screen 2, CU §5.1): the origin's illustration, the title and the lead.",
    "$extensions": {
      "app.foxdrop": { "web": ["sign-in-hero"], "flutter": ["sign_in_hero"] }
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.lg}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "art-gap": {
      "$type": "dimension",
      "$value": "{space.md}",
      "$description": "The illustration to the title."
    },
    "lead-gap": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$description": "The title to the lead."
    },
    "row-gap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "Between the illustration's rows and between the account's perks."
    },
    "detail-gap": {
      "$type": "dimension",
      "$value": "{space.xs}",
      "$description": "The cart's name to its total, the dishes to the chip, a perk's badge to its word."
    },
    "badge-size": {
      "$type": "dimension",
      "$value": "{size.touch-target}",
      "$description": "The round tinted badges and the dish circles."
    },
    "dish-overlap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "How far each dish circle slides under the one before it."
    },
    "dish-ring-width": {
      "$type": "dimension",
      "$value": "{border-width.thick}"
    },
    "color": {
      "$type": "color",
      "title": {
        "$value": "{color.heading}"
      },
      "lead": {
        "$value": "{color.on-surface}"
      },
      "details": {
        "$value": "{color.on-surface-muted}"
      },
      "badge": {
        "$value": "{color.primary-subtle}"
      },
      "badge-icon": {
        "$value": "{color.primary}",
        "$description": "The badges' and the dishes' Bold icons."
      },
      "dish-1": {
        "$value": "{color.primary-subtle}"
      },
      "dish-2": {
        "$value": "{color.info-subtle}"
      },
      "dish-3": {
        "$value": "{color.neutral-subtle}"
      },
      "dish-ring": {
        "$value": "{color.surface-raised}"
      }
    }
  }
}
