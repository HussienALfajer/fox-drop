{
  "button": {
    "$extensions": {
      "app.foxdrop": { "web": ["button"], "flutter": ["button"] }
    },
    "height": {
      "$type": "dimension",
      "$value": "{size.control}"
    },
    "compact": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control-compact}",
        "$description": "The panel's and the portal's compact density; the Flutter button has none.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{color.focus-ring}"
    },
    "primary": {
      "$type": "color",
      "background": {
        "$value": "{color.primary}"
      },
      "background-hover": {
        "$value": "{color.primary-hover}"
      },
      "background-pressed": {
        "$value": "{color.primary-pressed}"
      },
      "label": {
        "$value": "{color.on-primary}"
      }
    },
    "secondary": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}"
      },
      "background-hover": {
        "$value": "{color.surface-raised-hover}"
      },
      "background-pressed": {
        "$value": "{color.surface-raised-pressed}"
      },
      "border": {
        "$value": "{color.border-strong}"
      },
      "border-hover": {
        "$value": "{color.border-hover}"
      },
      "label": {
        "$value": "{color.on-surface}"
      }
    },
    "danger": {
      "$type": "color",
      "background": {
        "$value": "{color.danger}"
      },
      "background-hover": {
        "$value": "{color.danger-hover}"
      },
      "background-pressed": {
        "$value": "{color.danger-pressed}"
      },
      "label": {
        "$value": "{color.on-danger}"
      }
    },
    "ghost": {
      "$type": "color",
      "background-hover": {
        "$value": "{color.surface-hover}"
      },
      "background-pressed": {
        "$value": "{color.surface-pressed}"
      },
      "label": {
        "$value": "{color.on-surface}"
      }
    },
    "disabled": {
      "$type": "color",
      "background": {
        "$value": "{color.disabled}"
      },
      "label": {
        "$value": "{color.on-disabled}"
      }
    }
  }
}
