{
  "button": {
    "height": {
      "$type": "dimension",
      "$value": "{size.control}"
    },
    "compact": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control-compact}"
      }
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{color.focus-ring}"
    },
    "primary": {
      "$type": "color",
      "background": {
        "$value": "{color.primary}"
      },
      "background-pressed": {
        "$value": "{color.primary-pressed}"
      },
      "label": {
        "$value": "{color.on-primary}"
      }
    },
    "secondary": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}"
      },
      "background-pressed": {
        "$value": "{color.surface-pressed}"
      },
      "border": {
        "$value": "{color.border-strong}"
      },
      "label": {
        "$value": "{color.on-surface}"
      }
    },
    "danger": {
      "$type": "color",
      "background": {
        "$value": "{color.danger}"
      },
      "background-pressed": {
        "$value": "{color.alert}"
      },
      "label": {
        "$value": "{color.on-danger}"
      }
    },
    "ghost": {
      "$type": "color",
      "background-pressed": {
        "$value": "{color.surface-pressed}"
      },
      "label": {
        "$value": "{color.on-surface}"
      }
    },
    "disabled": {
      "$type": "color",
      "background": {
        "$value": "{color.disabled}"
      },
      "label": {
        "$value": "{color.on-disabled}"
      }
    }
  }
}
