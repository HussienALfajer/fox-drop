{
  "tracking-steps": {
    "$extensions": {
      "app.foxdrop": { "web": ["tracking-steps"], "flutter": ["tracking_steps"] }
    },
    "circle": {
      "$type": "dimension",
      "$value": "{size.touch-target}"
    },
    "label-gap": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "line-width": {
      "$type": "dimension",
      "$value": "{border-width.thick}",
      "$description": "The links between the circles, a later step's dashed outline and the current step's rings."
    },
    "dash": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$description": "A dash of a later link, and the space after it."
    },
    "color": {
      "$type": "color",
      "done": { "$value": "{color.info}" },
      "on-done": { "$value": "{color.on-info}" },
      "done-label": { "$value": "{color.info}" },
      "current": { "$value": "{color.primary}" },
      "on-current": { "$value": "{color.on-primary}" },
      "current-label": { "$value": "{color.primary-pressed}" },
      "pulse": { "$value": "{color.primary}" },
      "later": { "$value": "{color.surface-raised}" },
      "on-later": { "$value": "{color.on-surface-muted}" },
      "later-label": { "$value": "{color.on-surface-muted}" },
      "later-line": {
        "$value": "{color.border-strong}",
        "$description": "A later step's dashed outline and the dashed links after the current step."
      }
    }
  }
}
