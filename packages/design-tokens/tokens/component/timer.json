{
  "timer": {
    "$extensions": {
      "app.foxdrop": { "web": ["timer"], "flutter": ["timer"] }
    },
    "min-height": {
      "$type": "dimension",
      "$value": "{size.step}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$description": "The clock to the time."
    },
    "compact": {
      "min-height": {
        "$type": "dimension",
        "$value": "{space.lg}",
        "$description": "The panel's and the portal's density; the Flutter timer has none.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    },
    "calm": {
      "$type": "color",
      "background": { "$value": "{color.info-subtle}" },
      "text": { "$value": "{color.on-surface}" }
    },
    "soon": {
      "$type": "color",
      "background": { "$value": "{color.warning-subtle}" },
      "text": { "$value": "{color.warning}" }
    },
    "late": {
      "$type": "color",
      "background": { "$value": "{color.danger-subtle}" },
      "text": { "$value": "{color.danger}" }
    }
  }
}
