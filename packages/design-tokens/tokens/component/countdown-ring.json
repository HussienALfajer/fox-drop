{
  "countdown-ring": {
    "$extensions": {
      "app.foxdrop": { "web": ["countdown-ring"], "flutter": ["timer"] }
    },
    "size": {
      "$type": "dimension",
      "$value": "{size.countdown-ring}"
    },
    "stroke-width": {
      "$type": "dimension",
      "$value": "{border-width.ring}"
    },
    "color": {
      "$type": "color",
      "track": { "$value": "{color.neutral-subtle}" },
      "progress": { "$value": "{color.primary}" },
      "last": {
        "$value": "{color.danger}",
        "$description": "The arc and the number in the last 10 seconds."
      }
    }
  }
}
