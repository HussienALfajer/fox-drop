{
  "menu": {
    "$description": "The menu of actions under its trigger (D.10): a raised panel, rows with an icon, a destructive row in danger.",
    "$extensions": {
      "app.foxdrop": { "web": ["menu"], "flutter": ["menu"] }
    },
    "min-width": {
      "$type": "dimension",
      "$value": "{size.tooltip}",
      "$description": "The sheet's 240."
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.thin}",
      "$description": "The panel's outline and the separator."
    },
    "item-height": {
      "$type": "dimension",
      "$value": "{size.touch-target}"
    },
    "item-radius": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "item-padding-inline": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "item-gap": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "separator-margin-inline": {
      "$type": "dimension",
      "$value": "{space.xs}"
    },
    "separator-margin-block": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    },
    "compact": {
      "item-height": {
        "$type": "dimension",
        "$value": "{size.control-compact}",
        "$description": "The panel's and the portal's compact rows; the Flutter menu has one density.",
        "$extensions": { "app.foxdrop": { "sides": ["web"] } }
      }
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}"
      },
      "border": {
        "$value": "{color.border}"
      },
      "text": {
        "$value": "{color.on-surface}"
      },
      "danger": {
        "$value": "{color.danger}"
      },
      "item-hover": {
        "$value": "{color.surface-raised-hover}"
      },
      "item-pressed": {
        "$value": "{color.surface-raised-pressed}"
      }
    }
  }
}
