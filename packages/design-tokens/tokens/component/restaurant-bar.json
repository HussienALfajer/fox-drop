{
  "restaurant-bar": {
    "$description": "The restaurant app's bar on every screen (RA §6.2, D.10): the name, the status pill, the connection dot with its words, the support button.",
    "$extensions": {
      "app.foxdrop": { "web": ["restaurant-bar"], "flutter": ["top_bar"] }
    },
    "min-height": {
      "$type": "dimension",
      "$value": "{size.bar}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.md}"
    },
    "padding-block": {
      "$type": "dimension",
      "$value": "{space.2xs}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.sm}",
      "$description": "Between the name, the pill, the connection and the support button."
    },
    "dot-size": {
      "$type": "dimension",
      "$value": "{space.sm}"
    },
    "dot-gap": {
      "$type": "dimension",
      "$value": "{space.2xs}",
      "$description": "The dot to its words."
    },
    "border-width": {
      "$type": "dimension",
      "$value": "{border-width.thin}",
      "$description": "The hairline under the bar."
    },
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.surface-raised}"
      },
      "border": {
        "$value": "{color.border}"
      },
      "name": {
        "$value": "{color.on-surface}"
      },
      "connected": {
        "$value": "{color.success}",
        "$description": "The dot and «متصل»."
      },
      "offline": {
        "$value": "{color.danger}",
        "$description": "The dot and «غير متصل»."
      }
    }
  }
}
